#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# S01create_data - mount DATA on /mnt, creating it as ext4 only when it is safe.
#
# Contract: iariap/x6200_gui#212 (epic #211, findings F-01/F-18 of the #194
# assessment). DATA is the third partition of the SD card and the fstab declares
# it as ext4, but a card written with an older image carries a legacy vfat DATA
# and a card written from sdcard.img has no p3 at all until the first boot.
#
# Rules implemented here (each one has a case in
# br2_external/tests/test_S01create_data.sh):
#   1. An existing DATA - ext4, or legacy vfat - is mounted with its REAL type.
#      Nothing is ever reformatted and no file inside it is ever touched.
#   2. If the partition table already has a partition 3 or higher, this script
#      does not guess: it aborts asking for inspection (no mkfs, no mkpart, no
#      other partition is used).
#   3. On a fresh card (only p1 BOOT + p2 rootfs) it creates p3 as ext4 in the
#      trailing free region, 1 MiB aligned, with at least MIN_FREE_MIB MiB.
#   4. Every failure exits non-zero with "DATA unavailable: <reason>" and never
#      prints "DATA ready".
#
# It relies on the tools shipped in the X6200 rootfs (all present in the image:
# blkid/findmnt/mount/blockdev from util-linux - not the busybox applets -,
# parted and partprobe, mkfs.ext4 from e2fsprogs) and on the PATH set by init,
# the same one the previous S01create_data already used.
#
set -eu

DISK=/dev/mmcblk0
BOOT="${DISK}p1"
ROOT="${DISK}p2"
DATA="${DISK}p3"
MNT=/mnt

MIN_FREE_MIB=64
ALIGN_SECTORS=2048      # 1 MiB at 512 B/sector, the alignment genimage gives p1/p2
NODE_TRIES=5
NODE_WAIT=0.2           # seconds between attempts: bounded to 5 x 200 ms

emitted=0

fail() {
    emitted=1
    echo "DATA unavailable: $*" >&2
    exit 1
}

# Even an unexpected non-zero exit has to carry the contract's reason, and a
# partially done boot must never look like a successful one.
on_exit() {
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$emitted" -eq 0 ]; then
        echo "DATA unavailable: unexpected failure (exit $rc)" >&2
    fi
}
trap on_exit EXIT

ready() {
    echo "DATA ready ($1)"
}

# Canonical path of a device node, for mounts that came through /dev/disk/by-*.
resolve_dev() {
    if [ -e "$1" ]; then
        readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"
    else
        printf '%s\n' "$1"
    fi
}

# Fails unless $MNT is mounted from $DATA with the given type and read-write.
require_mounted() {
    expected_type="$1"

    mnt_line=""
    rc=0
    mnt_line=$(findmnt -n -r -o SOURCE,FSTYPE,OPTIONS --mountpoint "$MNT" 2>/dev/null) || rc=$?
    [ "$rc" -le 1 ] || fail "cannot read the mount state of $MNT (findmnt exited $rc)"
    [ -n "$mnt_line" ] || fail "$MNT is not mounted"

    mnt_src=$(printf '%s\n' "$mnt_line" | cut -d' ' -f1)
    mnt_type=$(printf '%s\n' "$mnt_line" | cut -d' ' -f2)
    mnt_opts=$(printf '%s\n' "$mnt_line" | cut -d' ' -f3)

    mnt_src_real=$(resolve_dev "$mnt_src")
    data_real=$(resolve_dev "$DATA")
    [ "$mnt_src_real" = "$data_real" ] ||
        fail "$MNT is mounted from $mnt_src, not from $DATA (existing mount requires inspection)"
    [ "$mnt_type" = "$expected_type" ] ||
        fail "$MNT is mounted as $mnt_type but $DATA is $expected_type"
    case ",$mnt_opts," in
        *,rw,*) ;;
        *) fail "$MNT is mounted read-only" ;;
    esac
}

start() {
    # --- 1. Is there a partition labelled DATA already? ----------------------
    # blkid -L exits 2 when no device carries the label: only that is "there is
    # no DATA". Any other status is a tool failure and must not be read as an
    # empty card, or this script would repartition a card it cannot inspect.
    data_dev=""
    rc=0
    data_dev=$(blkid -L DATA 2>/dev/null) || rc=$?
    case $rc in
        0) ;;
        2) data_dev="" ;;
        *) fail "cannot look up the DATA label (blkid exited $rc)" ;;
    esac

    if [ -n "$data_dev" ]; then
        # An existing DATA only ever lives on p3 of this card.
        [ "$data_dev" = "$DATA" ] ||
            fail "existing partition requires inspection (the DATA label is on $data_dev, not on $DATA)"

        data_type=""
        rc=0
        data_type=$(blkid -o value -s TYPE "$DATA" 2>/dev/null) || rc=$?
        [ "$rc" -eq 0 ] || fail "cannot read the filesystem type of $DATA (blkid exited $rc)"
        case $data_type in
            ext4 | vfat) ;;
            *) fail "existing partition requires inspection (the filesystem on $DATA is '${data_type:-unknown}')" ;;
        esac

        mount_line=""
        rc=0
        mount_line=$(findmnt -n -r -o SOURCE,FSTYPE,OPTIONS --mountpoint "$MNT" 2>/dev/null) || rc=$?
        [ "$rc" -le 1 ] || fail "cannot read the mount state of $MNT (findmnt exited $rc)"

        if [ -z "$mount_line" ]; then
            # -t with the real type: the fstab entry says ext4, which is only
            # right for a DATA created by this script. A legacy vfat DATA has to
            # be mounted as vfat, or it would not be readable.
            mount -t "$data_type" "$DATA" "$MNT" ||
                fail "cannot mount $DATA ($data_type) on $MNT (mount exited $?)"
        fi
        require_mounted "$data_type"

        case $data_type in
            vfat) ready "vfat legacy" ;;
            *) ready "$data_type" ;;
        esac
        return 0
    fi

    # --- 2. No DATA label: only a fresh ROM card is ours to partition --------
    table=""
    rc=0
    table=$(parted -m -s "$DISK" unit s print free 2>/dev/null) || rc=$?
    [ "$rc" -eq 0 ] || fail "cannot read the partition table of $DISK (parted exited $rc)"
    [ -n "$table" ] || fail "parted returned an empty partition table for $DISK"

    entries=$(printf '%s\n' "$table" | sed 's/;[[:space:]]*$//')
    parts=$(printf '%s\n' "$entries" | awk -F: '$1 ~ /^[0-9]+$/ && $5 != "free" { print $1, $2, $3 }')
    frees=$(printf '%s\n' "$entries" | awk -F: '
        $1 ~ /^[0-9]+$/ && $5 == "free" {
            s = $2; e = $3
            sub(/s$/, "", s); sub(/s$/, "", e)
            print s, e
        }')

    seen_boot=0
    seen_root=0
    for n in $(printf '%s\n' "$parts" | awk '{ print $1 }'); do
        case $n in
            1) seen_boot=1 ;;
            2) seen_root=1 ;;
            *) fail "existing partition requires inspection (partition $n already exists on $DISK)" ;;
        esac
    done
    [ "$seen_boot" -eq 1 ] || fail "$BOOT is missing: $DISK does not look like a freshly written ROM card"
    [ "$seen_root" -eq 1 ] || fail "$ROOT is missing: $DISK does not look like a freshly written ROM card"

    # DOS/MBR label and the filesystems of p1/p2: a card that is not a ROM card
    # must not be partitioned here. p1 being vfat is never taken as evidence of
    # what p3 is.
    plain=""
    rc=0
    plain=$(parted -s "$DISK" unit s print 2>/dev/null) || rc=$?
    [ "$rc" -eq 0 ] || fail "cannot read the partition table of $DISK (parted exited $rc)"

    label=$(printf '%s\n' "$plain" | sed -n 's/^Partition Table: *//p')
    [ "$label" = "msdos" ] ||
        fail "the partition table on $DISK is '${label:-unknown}', expected msdos (MBR)"

    boot_type=""
    rc=0
    boot_type=$(blkid -o value -s TYPE "$BOOT" 2>/dev/null) || rc=$?
    case $boot_type in
        vfat | fat) ;;
        *) fail "$BOOT is not a FAT filesystem (blkid says '${boot_type:-nothing}', exit $rc): $DISK does not look like a ROM card" ;;
    esac

    root_type=""
    rc=0
    root_type=$(blkid -o value -s TYPE "$ROOT" 2>/dev/null) || rc=$?
    case $root_type in
        ext2 | ext3 | ext4) ;;
        *) fail "$ROOT is not an ext filesystem (blkid says '${root_type:-nothing}', exit $rc): $DISK does not look like a ROM card" ;;
    esac

    disk_sectors=$(printf '%s\n' "$plain" | sed -n 's/^Disk .*: *\([0-9][0-9]*\)s$/\1/p')
    [ -n "$disk_sectors" ] || fail "cannot determine the size of $DISK"
    last_sector=$((disk_sectors - 1))

    # The trailing contiguous free region: the one reaching the end of the card.
    # A gap somewhere else (a leading one is normal in sdcard.img) is not a
    # candidate, so DATA never lands in the middle of the card.
    free_start=$(printf '%s\n' "$frees" | awk -v last="$last_sector" '$2 + 0 == last { print $1 }')
    [ -n "$free_start" ] ||
        fail "no free region reaches the end of $DISK: no room for $DATA without touching p1/p2"

    aligned_start=$(((free_start + ALIGN_SECTORS - 1) / ALIGN_SECTORS * ALIGN_SECTORS))
    [ "$aligned_start" -le "$last_sector" ] || fail "no aligned free space after $ROOT"
    usable_sectors=$((last_sector - aligned_start + 1))
    min_sectors=$((MIN_FREE_MIB * 1024 * 1024 / 512))
    [ "$usable_sectors" -ge "$min_sectors" ] ||
        fail "only $((usable_sectors / 2048)) MiB of aligned free space after $ROOT, need ${MIN_FREE_MIB} MiB"

    # Mounting over an existing mount would hide it: this path only runs on a
    # card where nothing mounted $MNT.
    pre_mount=""
    rc=0
    pre_mount=$(findmnt -n -r -o SOURCE,FSTYPE,OPTIONS --mountpoint "$MNT" 2>/dev/null) || rc=$?
    [ "$rc" -le 1 ] || fail "cannot read the mount state of $MNT (findmnt exited $rc)"
    [ -z "$pre_mount" ] || fail "$MNT is already mounted ($pre_mount): refusing to create DATA over it"

    # --- 3. Create p3, and nothing else -------------------------------------
    parted -m -s -a none "$DISK" unit s mkpart primary ext4 "${aligned_start}s" "${last_sector}s" ||
        fail "cannot create partition 3 on $DISK (parted exited $?)"
    partprobe "$DISK" || fail "partprobe failed on $DISK (exited $?)"

    # p1/p2 must be exactly what they were, and the new partition has to be the
    # one just asked for: only then is formatting p3 safe.
    table2=""
    rc=0
    table2=$(parted -m -s "$DISK" unit s print free 2>/dev/null) || rc=$?
    [ "$rc" -eq 0 ] || fail "cannot re-read the partition table of $DISK (parted exited $rc)"
    entries2=$(printf '%s\n' "$table2" | sed 's/;[[:space:]]*$//')
    parts2=$(printf '%s\n' "$entries2" | awk -F: '$1 ~ /^[0-9]+$/ && $5 != "free" { print $1, $2, $3 }')

    before12=$(printf '%s\n' "$parts" | awk '$1 == 1 || $1 == 2')
    after12=$(printf '%s\n' "$parts2" | awk '$1 == 1 || $1 == 2')
    [ "$before12" = "$after12" ] ||
        fail "p1/p2 changed while creating $DATA: refusing to format anything"

    created=$(printf '%s\n' "$parts2" | awk -v start="${aligned_start}s" '$1 == 3 && $2 == start')
    [ -n "$created" ] || fail "partition 3 was not created as requested (start ${aligned_start}s)"
    extra=$(printf '%s\n' "$parts2" | awk '$1 != 1 && $1 != 2 && $1 != 3 { print $1 }')
    [ -z "$extra" ] || fail "unexpected partition $extra on $DISK after creating $DATA"

    # The kernel publishes the node asynchronously: bounded wait, 5 x 200 ms.
    tries=0
    while [ "$tries" -lt "$NODE_TRIES" ]; do
        if [ -b "$DATA" ]; then
            break
        fi
        tries=$((tries + 1))
        sleep "$NODE_WAIT"
    done
    [ -b "$DATA" ] || fail "$DATA did not appear after creating partition 3"

    # The node has to be a readable block device of exactly the size just
    # created: anything else is not the partition this run made, and nothing gets
    # formatted on it (a stale node can point at a different device).
    data_bytes=""
    rc=0
    data_bytes=$(blockdev --getsize64 "$DATA" 2>/dev/null) || rc=$?
    [ "$rc" -eq 0 ] || fail "cannot read the size of $DATA (blockdev exited $rc)"
    want_bytes=$((usable_sectors * 512))
    [ "$data_bytes" = "$want_bytes" ] ||
        fail "$DATA is $data_bytes bytes, expected $want_bytes (partition 3 was not created as requested)"

    # Only a partition with no FILESYSTEM is formatted. blkid on a bare
    # partition (created a moment ago) can still succeed with only
    # PARTUUID=... and no TYPE; that is not a filesystem and must not stop the
    # mkfs. Any real type on this just-created p3 is foreign and stays untouched.
    old_type=""
    rc=0
    old_type=$(blkid -o value -s TYPE "$DATA" 2>/dev/null) || rc=$?
    case $rc in
        0 | 2) ;;
        *) fail "cannot read $DATA (blkid exited $rc)" ;;
    esac
    [ -z "$old_type" ] ||
        fail "$DATA already carries a filesystem (${old_type}): refusing to format it"

    # mke2fs escribe su progreso en stdout: va a stderr para que stdout lleve solo
    # los mensajes de este script (el contrato pide "DATA ready (<tipo>)" ahi).
    mkfs.ext4 -F -m 0 -L DATA "$DATA" >&2 || fail "mkfs.ext4 failed on $DATA (exited $?)"

    new_type=""
    rc=0
    new_type=$(blkid -o value -s TYPE "$DATA" 2>/dev/null) || rc=$?
    [ "$new_type" = "ext4" ] ||
        fail "$DATA is not ext4 after mkfs (blkid says '${new_type:-nothing}', exit $rc)"

    new_label=""
    rc=0
    new_label=$(blkid -o value -s LABEL "$DATA" 2>/dev/null) || rc=$?
    [ "$new_label" = "DATA" ] ||
        fail "$DATA is not labelled DATA after mkfs (blkid says '${new_label:-nothing}', exit $rc)"

    mount -t ext4 "$DATA" "$MNT" || fail "cannot mount $DATA (ext4) on $MNT (mount exited $?)"
    require_mounted ext4
    ready ext4
}

case "$1" in
    start)
        start
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start}" >&2
        exit 1
        ;;
esac
